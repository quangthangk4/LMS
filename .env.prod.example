# Public routing
PUBLIC_DOMAIN=library74.uk
ACME_EMAIL=admin@library74.uk

# PostgreSQL shared by Spring Boot and AI. Use one long random password.
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=library
BE_DATABASE_URL=jdbc:postgresql://postgres:5432/library
AI_DATABASE_URL=postgresql://library:replace-with-a-long-random-password@postgres:5432/library
SERVICE_CALLBACK_SECRET=replace-with-a-long-random-secret

# Backend integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
MAIL_HOST=smtp.zoho.com
MAIL_SENDER_USERNAME=
MAIL_SENDER_PASSWORD=
MAIL_NOREPLY_ADDRESS=noreply@library74.uk
MAIL_SUPPORT_ADDRESS=support@library74.uk
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
EXP_TOKEN=86400
EXP_REFRESH_TOKEN=604800
PAYOS_BASE_URL=https://api-merchant.payos.vn
CLIENT_ID_PAYOS=
API_KEY_PAYOS=
CHECKSUM_KEY_PAYOS=

# AI integrations and tuning
GEMINI_API_KEY=
AI_ETL_GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
AI_ETL_GEMINI_MODEL_PREMIUM=
AI_ETL_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
AI_ETL_CHUNK_SIZE=1500
AI_ETL_CHUNK_OVERLAP=150
AI_ETL_VECTOR_INSERT_BATCH_SIZE=256
AI_ETL_GEMINI_MIN_REQUEST_INTERVAL_SECONDS=10.0
AI_ETL_REDUCE_MAX_CHUNKS=12
AI_ETL_REDUCE_MAX_CHARS_PER_CHUNK=900
AI_ETL_REDUCE_TOTAL_CHARS_BUDGET=10000
AI_ETL_ENABLE_HASH_SKIP=true
AI_ETL_ALLOW_METADATA_FALLBACK=true
AI_ETL_ENABLE_OCR_FALLBACK=true
AI_ETL_OCR_MAX_PAGES=32
AI_ETL_OCR_DPI=160
AI_ETL_OCR_LANGUAGE=eng+vie
AI_ETL_OCR_MIN_TEXT_CHARS=500
AI_ETL_LLM_TIMEOUT_SECONDS=30
AI_ETL_LLM_RETRY_ATTEMPTS=2
AI_ETL_WORKER_CONCURRENCY=1
AI_ETL_WEBHOOK_TIMEOUT_SECONDS=8
AI_ETL_DB_POOL_MINCONN=1
AI_ETL_DB_POOL_MAXCONN=6
AI_API_DB_POOL_MINCONN=1
AI_API_DB_POOL_MAXCONN=12
AI_API_DB_STATEMENT_TIMEOUT_MS=5000
AI_API_DEFAULT_SEARCH_LIMIT=10
AI_API_MAX_SEARCH_LIMIT=50
AI_API_SEARCH_MIN_SIMILARITY=0.42
AI_API_SEARCH_STRICT_MIN_SIMILARITY=0.68
AI_API_RECOMMEND_DEFAULT_LIMIT=10
AI_API_RECOMMEND_MAX_LIMIT=50
AI_API_ALS_FACTORS=32
AI_API_ALS_REGULARIZATION=0.05
AI_API_ALS_ITERATIONS=15
AI_API_ALS_ALPHA=40
AI_API_ALS_MODEL_PATH=./models/als_model.pkl
AI_API_ALS_RETRAIN_INTERVAL_SECONDS=3600

# Read-only chatbot. Gemini uses approved guidance/tool JSON and writes the final Markdown.
# Optional shared Redis; Docker Compose sets REDIS_HOST=redis. No host port in production.
# Leave blank for the isolated Docker network, or set a strong password for both Redis and BE.
REDIS_PASSWORD=
# No key: reviewed suggested questions and exact aliases still work.
CHATBOT_GEMINI_API_KEY=
CHATBOT_GEMINI_MODEL=gemini-3.5-flash-lite
CHATBOT_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
CHATBOT_RAG_ENABLED=true
# Same random server-to-server secret on BE and ai-api; never a VITE variable.
CHATBOT_INTERNAL_API_KEY=

# Optional frontend analytics and observability profile
VITE_API_TIMEOUT=10000
VITE_GA_MEASUREMENT_ID=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=http://localhost:3001
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
